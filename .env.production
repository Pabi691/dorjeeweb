# Production build config for dorjeefashionfactory.com
# These VITE_* values are baked into the browser bundle at build time, so they
# contain nothing secret (the guest token is public by design). Hostinger runs
# `npm run build` in production mode and serves the generated dist/ folder.

# Laravel API — the backend subdomain.
VITE_API_URL=https://api.dorjeefashionfactory.com

# Uploaded images / media. Served straight from the API origin so that new
# CRM uploads appear with no extra copying. (A dedicated img. subdomain would
# go stale because the backend writes uploads into its own public/ folder.)
VITE_MEDIA_URL=https://api.dorjeefashionfactory.com

# Guest Sanctum token for the "webapp" user — lets visitors browse before
# logging in. Valid as long as the production DB is the imported `cloth` dump.
# Re-seeding the backend changes this; paste the new VITE_WEB_TOKEN here then.
VITE_WEB_TOKEN=91|frQ9VWm5k3MzgyUdxx9IcKJ7ClBhTZDWjpJ37ZFr

# Razorpay key id (empty = Cash on Delivery only).
VITE_RAZORPAY_KEY=

# Google reCAPTCHA v2 site key for the contact form (optional).
VITE_RECAPTCHA_SITE_KEY=
